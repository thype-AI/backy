# Copy to .env and fill in. .env is gitignored.

# --- databases ---------------------------------------------------------------
# Which databases to back up is NOT set here -- it lives in a JSON file mounted into
# the container. Copy databases.example.json to databases.json and edit it, then mount
# it (see compose.example.yml). Each entry may override any storage or notification
# setting below for that database alone.
#DATABASES_FILE=/config/databases.json

# --- storage -------------------------------------------------------------------
STORAGE_BACKEND=azure

# Must already exist -- backy does not create it, so it needs no container-create rights.
AZURE_STORAGE_CONTAINER=backups

# Either a connection string, or an account name plus a managed identity on the host
# (DefaultAzureCredential). The connection string wins if both are set.
AZURE_STORAGE_ACCOUNT=mystorageaccount
#AZURE_STORAGE_CONNECTION_STRING=

# --- notifications -------------------------------------------------------------
# Comma-separated, any of: webhook, slack, smtp, resend. Empty means failures only
# reach the log.
NOTIFY_CHANNELS=webhook

# Also send on success. Worth turning on: a failure-only setup is silent when this
# container never starts at all.
NOTIFY_ON_SUCCESS=false

# After one failure alert, stay quiet for this many minutes (0 = alert on every failed
# run). Survives restarts via NOTIFY_STATE_FILE -- mount a volume at /state for that.
# A success clears the state, so the next new outage alerts immediately.
NOTIFY_DEBOUNCE_MINUTES=0
#NOTIFY_STATE_FILE=/state/notify-state.json

# Generic JSON POST -- also how you reach Coolify, Discord, Teams or ntfy.
WEBHOOK_URL=https://example.com/hooks/backups

#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=backups@example.com
#SMTP_TO=me@example.com          # comma-separated for several recipients
#SMTP_STARTTLS=true

# Resend: email over HTTPS, no SMTP server to reach. The sending domain must be
# verified in Resend, or use onboarding@resend.dev to test.
#RESEND_API_KEY=re_...
#RESEND_FROM=backups@example.com
#RESEND_TO=me@example.com        # comma-separated for several recipients

# --- misc ----------------------------------------------------------------------
LOG_LEVEL=INFO

# Leave unset. Docker reuses the client timeout as the exec stream's socket read timeout,
# so any finite value kills a dump that pauses for longer than it.
#DOCKER_TIMEOUT=
